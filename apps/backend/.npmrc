# Use pnpm workspace protocol
auto-install-peers=true
strict-peer-dependencies=false

# Hoist all dependencies to root node_modules
shamefully-hoist=true
hoist=true

# Save exact versions instead of ranges
save-exact=false

# Allowed build scripts for pnpm v10+
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=esbuild
only-built-dependencies[]=msgpackr-extract
only-built-dependencies[]=prisma
