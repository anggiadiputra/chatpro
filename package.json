{
  "name": "kirimchat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KirimChat Monorepo",
  "scripts": {
    "dev": "concurrently --raw -n \"backend,frontend\" -c \"blue,magenta\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:pnpm": "pnpm --stream --filter \"./apps/*\" dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:salespage": "pnpm --filter salespage dev",
    "dev:backend": "pnpm --filter @kirimchat/backend dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:frontend": "pnpm --filter frontend build",
    "build:salespage": "pnpm --filter salespage build",
    "build:backend": "pnpm --filter @kirimchat/backend build",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:frontend": "pnpm --filter frontend start",
    "start:salespage": "pnpm --filter salespage start",
    "start:backend": "pnpm --filter @kirimchat/backend start",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "lint:fix": "pnpm --filter \"./apps/*\" lint:fix",
    "clean": "rm -rf node_modules apps/backend/node_modules apps/frontend/node_modules apps/backend/dist apps/frontend/.next apps/frontend/.open-next apps/frontend/.wrangler logs",
    "clean:cache": "rm -rf apps/backend/dist apps/frontend/.next apps/frontend/.open-next apps/frontend/.wrangler logs",
    "clean:deps": "rm -rf node_modules apps/backend/node_modules apps/frontend/node_modules",
    "prisma:generate": "pnpm --filter @kirimchat/backend prisma:generate",
    "prisma:db-push": "pnpm --filter @kirimchat/backend prisma:db-push",
    "prisma:migrate": "pnpm --filter @kirimchat/backend prisma:migrate",
    "prisma:seed": "pnpm --filter @kirimchat/backend prisma:seed",
    "docker:build": "docker build -t kirimchat-backend:latest -f apps/backend/Dockerfile .",
    "docker:build:no-cache": "docker build --no-cache -t kirimchat-backend:latest -f apps/backend/Dockerfile .",
    "docker:run": "docker run -p 3005:3005 --env-file apps/backend/.env kirimchat-backend:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend",
    "docker:restart": "docker-compose restart backend",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:push": "docker tag kirimchat-backend:latest your-registry/kirimchat-backend:latest && docker push your-registry/kirimchat-backend:latest"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.2",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "overrides": {
      "jose": "^6.1.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}